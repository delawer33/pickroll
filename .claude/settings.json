{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "TASK_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "deny": [
      "TaskOutput"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/context-guard.py"
          }
        ]
      }
    ]
  }
}
