# Скопировать в .env и заполнить. Реальный .env в git не коммитится.

# --- Postgres ---
POSTGRES_USER=court_vision
POSTGRES_PASSWORD=court_vision
POSTGRES_DB=court_vision
POSTGRES_PORT_INTERNAL=5432
POSTGRES_PORT_EXTERNAL=5432

# --- Redis ---
REDIS_PORT_INTERNAL=6379
REDIS_PORT_EXTERNAL=6379

# --- API ---
API_PORT_INTERNAL=8000
API_PORT_EXTERNAL=8000
ENVIRONMENT=local
# Локальный запуск бэкенда вне Compose (внутри Compose переопределяется на host=db)
DATABASE_URL=postgresql+asyncpg://court_vision:court_vision@localhost:5432/court_vision
CORS_ORIGINS=["http://localhost:5173"]
# JWKS инстанса Clerk: https://<frontend-api-домен>/.well-known/jwks.json
# (Clerk Dashboard → API Keys → Show JWT public key → JWKS URL). Ключи публичны.
CLERK_JWKS_URL=

# --- LLM ---
# Строка модели litellm: `<провайдер>/<модель>`. Смена провайдера (gemini/..., groq/...) —
# правка этой переменной, кода она не касается.
LLM_MODEL=anthropic/claude-haiku-4-5
LLM_TIMEOUT_SECONDS=60
# Потолок шагов агентного цикла: один шаг — один вызов модели.
LLM_MAX_STEPS=6
# Ключ провайдера. Пусто — litellm поищет его в окружении процесса сам
# (ANTHROPIC_API_KEY, GEMINI_API_KEY, GROQ_API_KEY); в `.env` для этого его класть
# бесполезно, файл разбирается в настройки, а не в окружение.
LLM_API_KEY=
# Адрес OpenAI-совместимого шлюза, если модель идёт через него. Тогда провайдер в
# LLM_MODEL — `openai/`, а дальше имя модели так, как её зовёт шлюз:
#   LLM_MODEL=openai/anthropic/claude-haiku-4.5
#   LLM_API_BASE=https://<шлюз>/v1
# Пусто = прямой адрес провайдера из LLM_MODEL. Через шлюз пустует `cost_usd` в
# `llm_usage`: прайслиста шлюза у litellm нет (см. docs/deferred.md).
LLM_API_BASE=
# Модель LLM-судьи eval ответов (`python -m court_vision.answer_eval`): сильнее модели
# агента, иначе судья одобряет ошибки судимого. Тот же шлюз и ключ, что у LLM_MODEL, —
# за шлюзом (LLM_API_BASE задан) имя пишется так, как его зовёт шлюз, с `openai/` впереди;
# `anthropic/claude-sonnet-4-5` через шлюз даёт 404 на /v1/v1/messages:
#   EVAL_JUDGE_MODEL=openai/anthropic/claude-sonnet-4.5
# Значение ниже — для прямого адреса провайдера (LLM_API_BASE пуст).
EVAL_JUDGE_MODEL=anthropic/claude-sonnet-4-5

# --- RAG ---
# Ключ реранкера (Jina). Реранкер — выключаемая ступень поиска по корпусу:
# пусто = результаты в порядке RRF-слияния, без реранка.
RERANK_API_KEY=

# --- Наблюдаемость ---
# Трейсы агентного цикла в Langfuse Cloud (Project Settings → API Keys). Без ключей
# трейсинг просто не включается — система работает как обычно.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Пусто = облако Langfuse (EU). Для self-hosted — URL своего инстанса.
LANGFUSE_HOST=

# --- Frontend ---
FRONTEND_PORT_INTERNAL=5173
FRONTEND_PORT_EXTERNAL=5173
# Порт здесь — API_PORT_EXTERNAL, а не INTERNAL: адрес открывает браузер, а не контейнер.
# Меняешь API_PORT_EXTERNAL (например, 8000 занят) — меняй и здесь, иначе фронтенд молча
# стучится не туда.
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
